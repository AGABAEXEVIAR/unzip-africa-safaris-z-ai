# =====================================================================
# Unzip Africa Safaris — Environment Variables
# =====================================================================
# Copy this file to .env.local and replace placeholders with real values.
# In production (Hostinger), set these in hPanel → Advanced → Environment Variables.
# Never commit .env.local (it's gitignored via .env*).

# --- Database (Hostinger MySQL) ---
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# IMPORTANT: URL-encode special characters in the password (e.g. @ → %40)
DATABASE_URL=mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:3306/YOUR_DB_NAME

# --- Admin Authentication ---
# Credentials for the admin dashboard login. Set ONLY in Hostinger env vars.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here

# --- JWT Session Secret ---
# Used to sign the admin session JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-32-char-secret-here

# --- Resend (transactional email) ---
# Get the API key from https://resend.com/api-keys after signing up.
# NEVER prefix with NEXT_PUBLIC_ — this stays server-side only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address for outgoing automated emails. The domain MUST be verified
# in Resend first (see https://resend.com/domains). Format:
#   "Unzip Africa Safaris <notifications@unzipafrica.com>"
RESEND_FROM_EMAIL=Unzip Africa Safaris <notifications@unzipafrica.com>

# Business inbox that receives every new booking/inquiry notification.
# This is your existing Hostinger mailbox — Resend only sends TO it,
# it does not replace it.
BOOKING_NOTIFICATION_EMAIL=info@unzipafrica.com

# Optional: Reply-To address shown on customer confirmation emails.
# Defaults to info@unzipafrica.com if not set.
RESEND_REPLY_TO_EMAIL=info@unzipafrica.com

# Optional: public base URL of the site, used for links inside emails.
# Defaults to https://unzipafrica.com if not set.
NEXT_PUBLIC_SITE_URL=https://unzipafrica.com

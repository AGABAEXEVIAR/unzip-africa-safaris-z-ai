# Copy this file to .env.local and replace the placeholder values with your
# actual MySQL credentials. Never commit .env.local (it's gitignored via .env*).
#
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Special characters in the password must be URL-encoded (e.g. spaces → %20).

DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/tours_booking

// =====================================================================
// Unzip Africa Safaris — Prisma schema (MySQL / Hostinger production)
// =====================================================================
// Complete tours & travel booking system: tours, accommodations, scheduled
// trips, destinations/game parks, testimonials, blog posts, bookings,
// quote requests, admin users, and global settings.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)

  @@index([email])
}

model TourPackage {
  id                 String   @id @default(cuid())
  name               String
  subtitle           String
  duration           String
  durationDays       Int
  durationNights     Int
  price              String
  priceFrom          Decimal  @db.Decimal(12, 2)
  priceOriginal      Decimal? @db.Decimal(12, 2)
  highlights         Json
  image              String   @db.Text
  galleryImages      Json?
  destination        String
  activities         Json
  tripType           String
  accommodationLevel String
  nationalPark       String
  featured           Boolean  @default(false)
  minAge             Int      @default(6)
  accommodationIds   Json
  createdAt          DateTime @default(now()) @db.Timestamp(0)
  updatedAt          DateTime @updatedAt @db.Timestamp(0)

  days     TourDay[]
  bookings Booking[]

  @@index([destination])
  @@index([featured])
}

model TourDay {
  id          String      @id @default(cuid())
  day         String
  title       String
  description String      @db.Text
  image       String      @db.Text
  tourId      String
  tour        TourPackage @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

model Accommodation {
  id            String   @id @default(cuid())
  name          String
  location      String
  type          String
  description   String   @db.Text
  image         String   @db.Text
  galleryImages Json?
  features      Json
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @db.Timestamp(0)

  @@index([location])
  @@index([type])
}

model ScheduledTrip {
  id                String   @id @default(cuid())
  name              String
  destination       String
  startDate         DateTime @db.Timestamp(0)
  endDate           DateTime @db.Timestamp(0)
  durationDays      Int
  priceFrom         Decimal  @db.Decimal(12, 2)
  priceOriginal     Decimal? @db.Decimal(12, 2)
  image             String   @db.Text
  galleryImages     Json?
  description       String   @db.Text
  highlights        Json
  inclusions        Json
  exclusions        Json
  groupSize         String
  spotsLeft         Int
  accommodationLevel String
  createdAt         DateTime @default(now()) @db.Timestamp(0)
  updatedAt         DateTime @updatedAt @db.Timestamp(0)

  stops    ScheduledTripStop[]
  bookings Booking[]

  @@index([destination])
  @@index([startDate])
}

model ScheduledTripStop {
  id               String        @id @default(cuid())
  day              String
  title            String
  description      String        @db.Text
  image            String        @db.Text
  scheduledTripId  String
  scheduledTrip    ScheduledTrip @relation(fields: [scheduledTripId], references: [id], onDelete: Cascade)

  @@index([scheduledTripId])
}

model Destination {
  id            String   @id @default(cuid())
  name          String
  country       String
  tagline       String
  description   String   @db.Text
  image         String   @db.Text
  imagePortrait String   @db.Text
  days          String
  price         String
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @db.Timestamp(0)

  gameParks GamePark[]

  @@index([country])
}

model GamePark {
  id            String      @id @default(cuid())
  name          String
  destinationId String
  description   String      @db.Text
  image         String      @db.Text
  wildlife      Json
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  avatar    String   @db.Text
  content   String   @db.Text
  published Boolean  @default(false)
  date      DateTime @db.Timestamp(0)

  @@index([published])
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  excerpt       String   @db.Text
  body          String   @db.LongText
  coverImage    String   @db.Text
  author        String
  authorRole    String?
  authorAvatar  String?  @db.Text
  publishedDate DateTime @db.Timestamp(0)
  tags          Json
  category      String
  readTimeMins  Int
  published     Boolean  @default(false)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @db.Timestamp(0)

  @@index([published])
  @@index([featured])
  @@index([category])
}

model Booking {
  id              String   @id @default(cuid())
  type            String
  tourId          String?
  scheduledTripId String?
  tripName        String
  destination     String
  startDate       DateTime? @db.Timestamp(0)
  endDate         DateTime? @db.Timestamp(0)
  duration        String?
  pricePerPerson  Decimal  @db.Decimal(12, 2)
  numTravellers   Int
  totalPrice      Decimal  @db.Decimal(12, 2)
  customerName    String
  customerEmail   String
  customerPhone   String
  notes           String?  @db.Text
  status          String   @default("PENDING")
  createdAt       DateTime @default(now()) @db.Timestamp(0)
  updatedAt       DateTime @updatedAt @db.Timestamp(0)

  tour          TourPackage?  @relation(fields: [tourId], references: [id], onDelete: SetNull)
  scheduledTrip ScheduledTrip? @relation(fields: [scheduledTripId], references: [id], onDelete: SetNull)

  @@index([tourId])
  @@index([scheduledTripId])
  @@index([status])
  @@index([customerEmail])
}

model QuoteRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  travelers    String?
  dates        String?
  destinations Json?
  budget       String?
  message      String   @db.Text
  status       String   @default("NEW")
  createdAt    DateTime @default(now()) @db.Timestamp(0)
  updatedAt    DateTime @updatedAt @db.Timestamp(0)

  @@index([status])
  @@index([email])
}

model Settings {
  id               Int      @id @default(1)
  companyName      String   @default("Unzip Africa Safaris")
  tagline          String?
  email            String   @default("hello@unzipafrica.com")
  phone            String?
  logoUrl          String?  @db.Text
  facebook         String?  @db.Text
  instagram        String?  @db.Text
  twitter          String?  @db.Text
  youtube          String?  @db.Text
  primaryColor     String?
  accentColor      String?
  whatsappNumber   String?
  whatsappMessage  String?  @db.Text
  copyright        String?
  developedBy      String?
  updatedAt        DateTime @updatedAt @db.Timestamp(0)
}

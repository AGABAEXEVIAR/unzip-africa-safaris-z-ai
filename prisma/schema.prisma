// =====================================================================
// Unzip Africa Safaris — Prisma schema (MySQL)
// =====================================================================
// Complete tours & travel booking system: tours, accommodations, scheduled
// trips, destinations/game parks, testimonials, blog posts, bookings,
// quote requests, admin users, and global settings.
//
// Run `npx prisma migrate dev --name init` on your local machine to apply
// this schema to your MySQL database (ServBay, localhost:3306).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Admin users (authenticates into the admin dashboard)
// ---------------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String // hashed via bcrypt in the API route, never plaintext
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)

  @@index([email])
}

enum Role {
  ADMIN
  EDITOR
}

// ---------------------------------------------------------------------
// Tour packages — bespoke journeys with day-by-day itinerary
// ---------------------------------------------------------------------
model TourPackage {
  id                 String   @id @default(cuid())
  name               String
  subtitle           String
  duration           String // display string, e.g. "10 Days · 9 Nights"
  durationDays       Int
  durationNights     Int
  price              String // display string, e.g. "From $4,800"
  priceFrom          Decimal  @db.Decimal(12, 2)
  priceOriginal      Decimal? @db.Decimal(12, 2)
  highlights         Json // string[]
  image              String   @db.Text
  galleryImages      Json? // string[]?
  destination        String
  activities         Json // string[]
  tripType           String
  accommodationLevel String
  nationalPark       String
  featured           Boolean  @default(false)
  minAge             Int      @default(6)
  accommodationIds   Json // string[] — links to Accommodation records
  createdAt          DateTime @default(now()) @db.Timestamp(0)
  updatedAt          DateTime @updatedAt @db.Timestamp(0)

  days     TourDay[]
  bookings Booking[]

  @@index([destination])
  @@index([featured])
  @@index([tripType])
  @@index([accommodationLevel])
}

model TourDay {
  id          String      @id @default(cuid())
  day         String // e.g. "Day 01"
  title       String
  description String      @db.Text
  image       String      @db.Text
  tourId      String
  tour        TourPackage @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
}

// ---------------------------------------------------------------------
// Accommodations — lodges & camps
// ---------------------------------------------------------------------
model Accommodation {
  id            String   @id @default(cuid())
  name          String
  location      String
  type          String
  description   String   @db.Text
  image         String   @db.Text
  galleryImages Json? // string[]?
  features      Json // string[]
  // Note: pricePerNight intentionally omitted — the public site shows
  // descriptions only, no prices (per the user's earlier requirement).
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @db.Timestamp(0)

  @@index([location])
  @@index([type])
}

// ---------------------------------------------------------------------
// Scheduled trips — fixed-date group departures with multi-stop itinerary
// ---------------------------------------------------------------------
model ScheduledTrip {
  id                 String   @id @default(cuid())
  name               String
  destination        String
  startDate          DateTime @db.Timestamp(0)
  endDate            DateTime @db.Timestamp(0)
  durationDays       Int
  priceFrom          Decimal  @db.Decimal(12, 2)
  priceOriginal      Decimal? @db.Decimal(12, 2)
  image              String   @db.Text
  galleryImages      Json? // string[]?
  description        String   @db.Text
  highlights         Json // string[]
  inclusions         Json // string[]
  exclusions         Json // string[]
  groupSize          String
  spotsLeft          Int
  accommodationLevel String
  createdAt          DateTime @default(now()) @db.Timestamp(0)
  updatedAt          DateTime @updatedAt @db.Timestamp(0)

  stops    ScheduledTripStop[]
  bookings Booking[]

  @@index([destination])
  @@index([startDate])
  @@index([accommodationLevel])
}

model ScheduledTripStop {
  id              String        @id @default(cuid())
  day             String // e.g. "Day 01-02"
  title           String
  description     String        @db.Text
  image           String        @db.Text
  scheduledTripId String
  scheduledTrip   ScheduledTrip @relation(fields: [scheduledTripId], references: [id], onDelete: Cascade)

  @@index([scheduledTripId])
}

// ---------------------------------------------------------------------
// Destinations — countries + their game parks
// ---------------------------------------------------------------------
model Destination {
  id            String   @id @default(cuid())
  name          String
  country       String
  tagline       String
  description   String   @db.Text
  image         String   @db.Text
  imagePortrait String   @db.Text
  days          String // e.g. "10 Days"
  price         String // e.g. "From $4,800"
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @db.Timestamp(0)

  gameParks GamePark[]

  @@index([country])
}

model GamePark {
  id            String      @id @default(cuid())
  name          String
  destinationId String
  description   String      @db.Text
  image         String      @db.Text
  wildlife      Json // string[]
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

// ---------------------------------------------------------------------
// Testimonials — customer reviews shown on the homepage marquee
// ---------------------------------------------------------------------
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  avatar    String   @db.Text
  content   String   @db.Text
  published Boolean  @default(false)
  date      DateTime @db.Timestamp(0)

  @@index([published])
}

// ---------------------------------------------------------------------
// Blog posts — managed in admin, displayed on the public blog page
// ---------------------------------------------------------------------
model BlogPost {
  id            String   @id @default(cuid())
  title         String
  excerpt       String   @db.Text
  body          String   @db.LongText
  coverImage    String   @db.Text
  author        String
  authorRole    String?
  authorAvatar  String?  @db.Text
  publishedDate DateTime @db.Timestamp(0)
  tags          Json // string[]
  category      String
  readTimeMins  Int
  published     Boolean  @default(false)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @db.Timestamp(0)

  @@index([published])
  @@index([featured])
  @@index([category])
  @@index([publishedDate])
}

// ---------------------------------------------------------------------
// Bookings — customer reservation requests for tours or scheduled trips
// ---------------------------------------------------------------------
model Booking {
  id              String         @id @default(cuid())
  type            BookingType
  tourId          String?
  tour            TourPackage?   @relation(fields: [tourId], references: [id], onDelete: SetNull)
  scheduledTripId String?
  scheduledTrip   ScheduledTrip? @relation(fields: [scheduledTripId], references: [id], onDelete: SetNull)
  tripName        String
  destination     String
  startDate       DateTime?      @db.Timestamp(0)
  endDate         DateTime?      @db.Timestamp(0)
  duration        String?
  pricePerPerson  Decimal        @db.Decimal(12, 2)
  numTravellers   Int
  totalPrice      Decimal        @db.Decimal(12, 2)
  customerName    String
  customerEmail   String
  customerPhone   String
  notes           String?        @db.Text
  status          BookingStatus  @default(PENDING)
  createdAt       DateTime       @default(now()) @db.Timestamp(0)
  updatedAt       DateTime       @updatedAt @db.Timestamp(0)

  @@index([tourId])
  @@index([scheduledTripId])
  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

enum BookingType {
  TOUR
  SCHEDULED_TRIP
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// ---------------------------------------------------------------------
// Quote requests — submitted via the contact form / "Request a Quote"
// ---------------------------------------------------------------------
model QuoteRequest {
  id           String      @id @default(cuid())
  name         String
  email        String
  phone        String?
  travelers    String?
  dates        String?
  destinations Json? // string[]
  budget       String?
  message      String      @db.Text
  status       QuoteStatus @default(NEW)
  createdAt    DateTime    @default(now()) @db.Timestamp(0)
  updatedAt    DateTime    @updatedAt @db.Timestamp(0)

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

enum QuoteStatus {
  NEW
  CONTACTED
  WON
  LOST
}

// ---------------------------------------------------------------------
// Settings — singleton row (id=1) holding global site configuration.
// Loaded by the admin Settings page; never written to from the client.
// ---------------------------------------------------------------------
model Settings {
  id              Int      @id @default(1)
  companyName     String
  tagline         String?
  email           String
  phone           String?
  logoUrl         String?  @db.Text
  facebook        String?  @db.Text
  instagram       String?  @db.Text
  twitter         String?  @db.Text
  youtube         String?  @db.Text
  primaryColor    String? // hex, e.g. "#2C3A2E"
  accentColor     String? // hex, e.g. "#A88B5C"
  whatsappNumber  String?
  whatsappMessage String?  @db.Text
  copyright       String?
  developedBy     String?
  updatedAt       DateTime @updatedAt @db.Timestamp(0)
}
